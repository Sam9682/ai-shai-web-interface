# Database Configuration
DATABASE_URL=postgresql://shai_user:password@postgres:5432/shai_db
POSTGRES_PASSWORD=password

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Email Configuration (SMTP)
SMTP_HOST=mail.gandi.net
SMTP_PORT=587
SMTP_USER=admin@ai-shai-web-interface.fr
SMTP_PASSWORD=your-email-password
SMTP_FROM=noreply@ai-shai-web-interface.fr

# Payment Configuration
STRIPE_API_KEY=sk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_MODE=sandbox

# Application Configuration
APP_NAME=AI-SHAI
APP_VERSION=1.0.0
DEBUG=True
ALLOWED_ORIGINS=http://ai-shai-web-interface:8000,http://frontend,https://opcp-psmc.com

# Docker Ports
HTTP_PORT=6000
HTTP_PORT2=6002
HTTPS_PORT=6001
FRONTEND_PORT=6003

# File Storage
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_SIZE=10485760

# Membership Fee (in EUR)
ANNUAL_MEMBERSHIP_FEE=50.00

# Oracle AI Configuration
# Kiro AI est le fournisseur par défaut (gratuit, inclus dans le container Docker)
# Aucune configuration requise pour Kiro AI

# Fournisseurs alternatifs (optionnels, nécessitent des clés API)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4
# SHAI_API_KEY=your_shai_api_key_here
# SHAI_API_URL=https://oai.endpoints.kepler.ai.cloud.ovh.net/v1

# Cloud Storage Configuration (pour les sauvegardes)

# AWS S3 (par défaut)
# Configurez avec 'aws configure' ou définissez ces variables:
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_DEFAULT_REGION=eu-west-3

# OVH Object Storage (alternative compatible S3)
# OVH_S3_ACCESS_KEY=your_ovh_access_key
# OVH_S3_SECRET_KEY=your_ovh_secret_key
# OVH_S3_ENDPOINT=https://s3.gra.io.cloud.ovh.net
# OVH_S3_REGION=gra
